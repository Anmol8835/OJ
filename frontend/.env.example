# Frontend build-time configuration (Vite).
# Copy to `.env` for local overrides, or pass as --build-arg when building the
# Docker image for deployment. If unset, config.js falls back to localhost.

# Compiler backend (problems + code execution)
VITE_API_URL=http://localhost:8001

# Auth backend (login/register)
VITE_AUTH_URL=http://localhost:8000
